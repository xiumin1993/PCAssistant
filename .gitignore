# ================================
# PC Assistant - Git Ignore
# ================================

# --------------------------------
# 通用 / Miscellaneous
# --------------------------------
*.class
*.log
*.pyc
*.swp
*.bak
*.tmp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
Thumbs.db
desktop.ini

# --------------------------------
# IDE / 编辑器
# --------------------------------
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/
.vscode/

# --------------------------------
# Flutter / Dart / Pub
# --------------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
.widget_preview/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Android Studio build artifacts
/android/app/debug
/android/app/profile
/android/app/release

# --------------------------------
# Android 构建产物
# --------------------------------
android/.gradle/
android/.kotlin/
android/**/build/
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
android/GeneratedPluginRegistrant.java
android/.cxx/
android/gradle-wrapper.jar

# Android 签名密钥（绝对不要提交）
key.properties
**/*.keystore
**/*.jks

# --------------------------------
# iOS 构建产物
# --------------------------------
ios/**/dgph
ios/**/*.mode1v3
ios/**/*.mode2v3
ios/**/*.moved-aside
ios/**/*.pbxuser
ios/**/*.perspectivev3
ios/**/*sync/
ios/**/.sconsign.dblite
ios/**/.tags*
ios/**/.vagrant/
ios/**/DerivedData/
ios/Icon?
ios/**/Pods/
ios/**/.symlinks/
ios/profile
ios/xcuserdata
ios/**/.generated/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*

# iOS 例外规则（保留默认配置）
!ios/default.mode1v3
!ios/default.mode2v3
!ios/default.pbxuser
!ios/default.perspectivev3

# --------------------------------
# 其他平台构建产物（未来扩展）
# --------------------------------
windows/runner/flutter_window.cpp
windows/runner/win32_app.cpp
linux/flutter/generated_*
macos/Flutter/GeneratedPluginRegistrant.*

# --------------------------------
# 日志 & 缓存
# --------------------------------
*.log
logs/
.cache/
__pycache__/
node_modules/

# --------------------------------
# 本地验证截图（真机截屏含人脸，不入库）
# --------------------------------
design/shots/

# --------------------------------
# graphify 知识图谱产物（本地生成，可重新生成，不入库）
# --------------------------------
/graphify-out/
/graphify-out-src/

# --------------------------------
# 打包产物兜底
# --------------------------------
# 正常产物都在 /build/ 里（已被忽略），这里是防止
# 把 APK 拷到别的目录后误提交 —— 二进制进仓库会永久撑大体积。
*.apk
*.aab
*.ipa

# Flutter 旧版生成的插件清单（现已改用 .flutter-plugins-dependencies）
.flutter-plugins

# --------------------------------
# libjpeg-turbo 源码（11MB，只在重建预编译库时才需要）
# --------------------------------
# 日常构建只用 android/app/src/main/cpp/prebuilt/ 里的 .a（已入库），
# 源码由 build_libjpeg_turbo.sh 自动下载，不必进仓库。
android/app/src/main/cpp/libjpeg-turbo/
android/app/src/main/cpp/_build_ljt*/

# --------------------------------
# 敏感信息（可选）
# --------------------------------
.env
.env.local
*.pem
*.key
